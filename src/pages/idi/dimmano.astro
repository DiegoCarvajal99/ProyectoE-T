---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const researchLines = [
  { title: 'Diseño y Manufactura', desc: 'Desarrollo de prototipos y procesos industriales con alta eficiencia energética.' },
  { title: 'Materiales y Procesos', desc: 'Investigación en nanotecnología y materiales de baja huella ambiental.' },
  { title: 'Optimización y Métodos Numéricos', desc: 'Modelado computacional para la resolución de problemas de ingeniería complejos.' }
];
---

<Layout title="Dimmano | Grupo de Investigación ETF">
  <main>
    <!-- Hero Section: Full Height -->
    <section class="relative min-h-screen flex items-center bg-slate-950 overflow-hidden pt-20">
      <div class="absolute inset-0 opacity-25">
        <img 
          src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" 
          alt="Diseño y Manufactura" 
          class="w-full h-full object-cover grayscale brightness-50"
        />
      </div>
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-3 bg-secondary/20 backdrop-blur-md border border-secondary/30 px-4 py-2 rounded-full mb-8">
            <span class="text-secondary text-[10px] font-black uppercase tracking-widest">Ingeniería Avanzada</span>
          </div>
          <h1 class="text-5xl md:text-8xl font-black text-white mb-8 tracking-tightest leading-tight">
            Grupo <span class="text-gradient">Dimmano</span>
          </h1>
          <p class="text-xl text-slate-300 font-medium leading-relaxed max-w-2xl mb-12">
            Diseño, Manufactura, Materiales y Nanotecnología. Investigamos desde 2010 para revolucionar la ingeniería aplicada en el Caribe Colombiano.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
             <Button variant="primary" size="lg" href="https://scienti.minciencias.gov.co/gruplac/jsp/visualiza/visualizagr.jsp?nro=00000000021703" target="_blank" rel="noopener noreferrer">
                Ver Perfil Gruplac
             </Button>
             <Button variant="outline" size="lg" href="https://scienti.minciencias.gov.co/cvlac/visualizador/generarCurriculoCv.do?cod_rh=0001526397" target="_blank" rel="noopener noreferrer" class="text-white border-white/20 hover:bg-white/10">
                Líder: Massimo Leserri
             </Button>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
         <span class="text-[9px] font-black text-white/30 uppercase tracking-[0.3em]">Vertical Lab</span>
         <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </section>

    <!-- Info Section -->
    <section class="py-32 bg-white">
      <div class="container mx-auto px-6">
        <div class="flex flex-col xl:flex-row gap-20 items-start">
          <div class="xl:w-1/2 reveal">
            <SectionHeader 
              tag="I+D Aplicado"
              title="Transformando la Industria"
              subtitle="Nuestra misión es generar patentes y soluciones tecnológicas de alto nivel para mejorar la competitividad regional."
              centered={false}
            />
            <p class="text-lg text-slate-600 leading-relaxed font-medium mb-8">
              Bajo el liderazgo del Dr. <a href="https://scienti.minciencias.gov.co/cvlac/visualizador/generarCurriculoCv.do?cod_rh=0001526397" target="_blank" class="text-secondary font-bold hover:underline decoration-secondary/20 underline-offset-4 pointer-events-none">Massimo Leserri</a>, el grupo Dimmano se enfoca en el desarrollo de talento humano de alto nivel en ingeniería mecánica, materiales y nanotecnología.
            </p>
            <div class="flex items-center gap-6 p-8 bg-amber-50 rounded-[3rem] border border-amber-100">
               <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-lg text-secondary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
               </div>
               <div>
                  <p class="text-slate-900 font-black text-lg">Categoría B</p>
                  <p class="text-slate-500 text-[10px] font-black uppercase tracking-widest">MinCiencias Colombia</p>
               </div>
            </div>
          </div>
          
          <div class="xl:w-1/2 grid sm:grid-cols-2 gap-6 reveal">
            {researchLines.map(line => (
              <div class="p-10 rounded-[3.5rem] bg-slate-50 border border-slate-100 group hover:bg-white hover:shadow-2xl transition-all">
                <div class="w-10 h-10 bg-secondary/10 rounded-xl flex items-center justify-center text-secondary mb-6 group-hover:scale-110 transition-transform">
                   <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </div>
                <h4 class="text-slate-900 font-bold text-lg mb-4 tracking-tight">{line.title}</h4>
                <p class="text-slate-500 text-sm leading-relaxed font-medium">{line.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
