---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const researchLines = [
  { title: 'Competitividad Territorial', desc: 'Análisis de factores organizacionales y territoriales para el desarrollo económico.' },
  { title: 'Desarrollo Sostenible', desc: 'Modelos de crecimiento que equilibran lo económico, social y ambiental.' }
];
---

<Layout title="Sostenibilidad y Competitividad | Grupo de Investigación ETF">
  <main>
    <!-- Hero Section: Full Height -->
    <section class="relative min-h-screen flex items-center bg-slate-950 overflow-hidden pt-20">
      <div class="absolute inset-0 opacity-20">
        <img 
          src="https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" 
          alt="Sostenibilidad y Competitividad" 
          class="w-full h-full object-cover grayscale brightness-50"
        />
      </div>
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-3 bg-secondary/20 backdrop-blur-md border border-secondary/30 px-4 py-2 rounded-full mb-8">
            <span class="text-secondary text-[10px] font-black uppercase tracking-widest">Desarrollo Regional</span>
          </div>
          <h1 class="text-5xl md:text-8xl font-black text-white mb-8 tracking-tightest leading-tight">
            Sostenibilidad y <br/> <span class="text-gradient">Competitividad</span>
          </h1>
          <p class="text-xl text-slate-300 font-medium leading-relaxed max-w-2xl mb-12">
            Desde 2010, investigamos la sinergia entre la rentabilidad organizacional y el bienestar socioambiental para el Caribe Colombiano.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
             <Button variant="primary" size="lg" href="https://scienti.minciencias.gov.co/gruplac/jsp/visualiza/visualizagr.jsp?nro=00000000021567" target="_blank" rel="noopener noreferrer">
                Ver Perfil Gruplac
             </Button>
             <Button variant="outline" size="lg" href="https://scienti.minciencias.gov.co/cvlac/visualizador/generarCurriculoCv.do?cod_rh=0001758402" target="_blank" rel="noopener noreferrer" class="text-white border-white/20 hover:bg-white/10">
                Líder: Arlet Franco
             </Button>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
         <span class="text-[9px] font-black text-white/30 uppercase tracking-[0.3em]">Visión 2030</span>
         <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </section>

    <!-- Info Section -->
    <section class="py-32 bg-white">
      <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-20 items-center">
          <div class="lg:w-1/2 reveal">
            <SectionHeader 
              tag="Visión Estratégica"
              title="Equilibrio para el Progreso"
              subtitle="Entendemos la sostenibilidad no como una meta, sino como el eje central de un desarrollo competitivo genuino."
              centered={false}
            />
            <p class="text-lg text-slate-600 leading-relaxed font-medium mb-8">
              Bajo el liderazgo de la investigadora <a href="https://scienti.minciencias.gov.co/cvlac/visualizador/generarCurriculoCv.do?cod_rh=0001758402" target="_blank" class="text-emerald-600 font-bold hover:underline decoration-emerald-200 underline-offset-4 pointer-events-none">Arlet Patricia Franco Peñata</a>, este grupo analiza los modelos de negocio y las políticas territoriales para un crecimiento económico respetuoso.
            </p>
            <div class="flex items-center gap-6 p-8 bg-emerald-50 rounded-[3rem] border border-emerald-100">
               <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-lg text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
               </div>
               <div>
                  <p class="text-slate-900 font-black text-lg">Categoría C</p>
                  <p class="text-slate-500 text-[10px] font-black uppercase tracking-widest">Ranking MinCiencias</p>
               </div>
            </div>
          </div>
          
          <div class="lg:w-1/2 space-y-6 reveal">
            <h3 class="text-2xl font-black text-slate-900 mb-10 tracking-tightest px-4">Líneas Prioritarias</h3>
            {researchLines.map(line => (
              <div class="p-10 rounded-[3rem] bg-slate-50 border border-slate-100 group hover:border-primary/20 transition-all">
                <div class="flex items-start gap-6">
                   <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-primary shadow-sm group-hover:scale-110 transition-transform">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17.07V12l-5 5-5-5-5 5-5-5V6.93l5 5 5-5 5 5 5-5v10.14z"/></svg>
                   </div>
                   <div>
                      <h4 class="text-slate-900 font-black text-xl mb-3 tracking-tight group-hover:text-primary transition-colors">{line.title}</h4>
                      <p class="text-slate-500 text-sm leading-relaxed font-medium">{line.desc}</p>
                   </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
