---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const topics = [
  { title: 'Conflictos Socioambientales', desc: 'Análisis de las tensiones en el territorio por el uso de recursos naturales.', icon: '🌋' },
  { title: 'Tecnología para el Bien Común', desc: 'Cómo la innovación digital puede empoderar a las comunidades rurales.', icon: '📡' },
  { title: 'Gobernanza del Agua', desc: 'Debates sobre la gestión sostenible del recurso hídrico en el Caribe.', icon: '💧' }
];

const episodes = [
  { 
    id: 'k5S76Kzonqk', 
    title: 'Geografía Tropical', 
    category: 'Territorio', 
    date: 'Episodio Destacado',
    desc: 'Exploramos las particularidades de nuestra región y cómo el clima define nuestra cultura y retos ambientales.'
  },
  { 
    id: 'r87AMkINKNc', 
    title: 'Vulcanismo en Colombia', 
    category: 'Geociencias', 
    date: 'Emisión #42',
    desc: 'Un recorrido por la actividad geológica de nuestro país y su impacto en el desarrollo regional.'
  },
  { 
    id: 'WrZyLM_dz0U', 
    title: 'Conservación del Manatí', 
    category: 'Ecosistemas', 
    date: 'Emisión #38',
    desc: 'Hablamos sobre los esfuerzos comunitarios para la preservación de esta especie clave en nuestras ciénagas.'
  },
  { 
    id: '2OM3AfWtK04', 
    title: 'Impacto de Pesticidas', 
    category: 'Sostenibilidad', 
    date: 'Emisión #35',
    desc: 'Debate técnico sobre las consecuencias del uso de químicos en la agricultura y alternativas ecológicas.'
  },
  { 
    id: '4h7kws9wheU', 
    title: 'Gestión de Avalúos', 
    category: 'Territorio', 
    date: 'Emisión #31',
    desc: 'Análisis sobre la valoración del suelo y su relación con la planificación urbana y rural.'
  },
  { 
    id: 'dZBsdfOxd-g', 
    title: 'Dinámicas de Emigrantes', 
    category: 'Sociedad', 
    date: 'Emisión #28',
    desc: 'Cómo los movimientos poblacionales reconfiguran la identidad territorial y los servicios básicos.'
  }
];

const featuredEpisode = episodes[0];
const archiveEpisodes = episodes.slice(1);
---

<Layout title="Ambiente, Territorio y Tecnología | Podcast ETF">
  <main class="bg-slate-950">
    <!-- Hero Section con Efecto Radial -->
    <section class="relative min-h-screen flex items-center overflow-hidden pt-20">
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1478737270239-2f02b77fc618?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" 
          alt="Radio Studio" 
          class="w-full h-full object-cover opacity-20 grayscale"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-secondary/10 to-slate-950"></div>
      </div>

      <!-- Sound Waves Background -->
      <div class="absolute inset-0 opacity-10 pointer-events-none overflow-hidden">
         <div class="flex items-center justify-around h-full gap-4 px-10">
            {Array.from({length: 40}).map((_, i) => (
               <div 
                  class="w-1 bg-secondary rounded-full" 
                  style={`height: ${Math.random() * 80 + 20}%; animation: soundWave ${Math.random() * 2 + 1}s ease-in-out infinite alternate; animation-delay: ${Math.random() * 3}s`}
               ></div>
            ))}
         </div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-3 bg-white/5 backdrop-blur-xl border border-white/10 px-6 py-2 rounded-full mb-10 reveal">
            <span class="w-3 h-3 bg-secondary rounded-full animate-pulse shadow-[0_0_15px_rgba(var(--secondary),0.8)]"></span>
            <span class="text-white text-xs font-black uppercase tracking-[0.3em]">Radio Institucional Unicórdoba</span>
          </div>
          <h1 class="text-6xl md:text-9xl font-black text-white mb-10 tracking-tightest leading-[0.85] reveal">
            Ambiente & <br/> <span class="text-gradient">Tecnología</span>
          </h1>
          <p class="text-2xl text-slate-400 font-medium leading-relaxed max-w-2xl mb-14 reveal delay-200">
            Debatiendo el futuro de nuestro territorio desde la ciencia y la innovación regenerativa.
          </p>
          
          <div class="flex flex-wrap gap-8 items-center reveal delay-400">
             <Button variant="secondary" size="lg" href="#episodios">Explorar Archivo</Button>
             <div class="flex items-center gap-6 p-6 rounded-[2.5rem] bg-white/5 border border-white/10 backdrop-blur-xl group hover:bg-white/10 transition-all">
                <div class="w-14 h-14 rounded-2xl bg-secondary/20 flex items-center justify-center text-secondary shadow-[0_0_20px_rgba(16,185,129,0.2)]">
                   <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M2 10v4"/><path d="M22 10v4"/><path d="M7 6v12"/><path d="M17 6v12"/></svg>
                </div>
                <div>
                   <p class="text-white font-black text-xs uppercase tracking-widest mb-1">En Sintonía</p>
                   <p class="text-slate-400 font-bold">98.5 FM Cordoba</p>
                </div>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Propósito con Tarjetas Tech -->
    <section class="py-40 bg-white relative overflow-hidden">
       <div class="absolute -top-32 -right-32 w-96 h-96 bg-secondary/5 rounded-full blur-[100px]"></div>
       
       <div class="container mx-auto px-6">
          <div class="grid lg:grid-cols-2 gap-32 items-start">
             <div class="reveal">
                <SectionHeader 
                   tag="Misión"
                   title="Conectamos el Saber con el Territorio"
                   subtitle="Un puente entre la academia y la comunidad para una gobernanza ambiental real."
                   centered={false}
                />
                <p class="text-xl text-slate-500 leading-relaxed font-medium mt-10 mb-12">
                   Buscamos democratizar el acceso a la información técnica, permitiendo que las comunidades tomen decisiones informadas sobre su entorno.
                </p>
                <div class="p-10 rounded-[3rem] bg-slate-950 text-white relative overflow-hidden group">
                   <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-secondary/10 rounded-full blur-[50px] group-hover:scale-150 transition-transform duration-700"></div>
                   <h4 class="text-2xl font-black mb-4 tracking-tight">Participa en el Debate</h4>
                   <p class="text-slate-400 font-medium mb-8">Nuestras líneas están abiertas para reportes ambientales ciudadanos.</p>
                   <Button variant="secondary" href="https://api.whatsapp.com/send?phone=573042247552">Enviar Reporte</Button>
                </div>
             </div>

             <div class="grid gap-8 reveal delay-300">
                {topics.map(topic => (
                   <div class="p-12 rounded-[4rem] bg-slate-50 border border-slate-100 hover:shadow-2xl hover:scale-[1.02] transition-all duration-500 group">
                      <div class="text-4xl mb-6 group-hover:scale-125 transition-transform duration-500 origin-left">{topic.icon}</div>
                      <h4 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">{topic.title}</h4>
                      <p class="text-slate-500 text-lg leading-relaxed font-medium">{topic.desc}</p>
                   </div>
                ))}
             </div>
          </div>
       </div>
    </section>

    <!-- Section: Archivo de Emisiones Premium -->
    <section id="episodios" class="py-40 bg-slate-950 relative overflow-hidden">
       <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] bg-secondary/5 rounded-full blur-[200px] pointer-events-none"></div>

       <div class="container mx-auto px-6">
          <SectionHeader 
             tag="Galería Multimedia"
             title="Archivo de Emisiones"
             subtitle="Explora los temas que están redefiniendo el futuro de nuestra región."
             light={true}
          />

          <!-- Featured Gallery Video -->
          <div class="mt-24 mb-20 reveal">
             <div class="group relative bg-[#0a0f18] rounded-[5rem] overflow-hidden border border-white/5 shadow-2xl hover:border-secondary/30 transition-all duration-700">
                <div class="grid lg:grid-cols-2">
                   <div class="aspect-video lg:aspect-auto h-full relative overflow-hidden group-hover:brightness-110 transition-all">
                      <iframe 
                         width="100%" height="100%" 
                         src={`https://www.youtube.com/embed/${featuredEpisode.id}`} 
                         class="absolute inset-0" 
                         allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
                         allowfullscreen
                      ></iframe>
                   </div>
                   <div class="p-16 flex flex-col justify-center">
                      <div class="inline-flex items-center gap-3 bg-secondary/10 border border-secondary/20 px-5 py-2 rounded-full mb-8 self-start">
                         <span class="w-2 h-2 bg-secondary rounded-full animate-ping"></span>
                         <span class="text-secondary text-[10px] font-black uppercase tracking-widest">{featuredEpisode.category}</span>
                      </div>
                      <span class="text-slate-500 text-sm font-black uppercase tracking-[0.2em] mb-4">{featuredEpisode.date}</span>
                      <h3 class="text-5xl font-black text-white mb-8 tracking-tightest leading-tight">{featuredEpisode.title}</h3>
                      <p class="text-xl text-slate-400 font-medium leading-relaxed mb-10">{featuredEpisode.desc}</p>
                      <div class="flex gap-4">
                         <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:text-secondary hover:border-secondary transition-all cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                         </div>
                         <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:text-secondary hover:border-secondary transition-all cursor-pointer">
                             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                         </div>
                      </div>
                   </div>
                </div>
             </div>
          </div>

          <!-- Archive Grid Tech -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
             {archiveEpisodes.map((episode, index) => (
                <div class={`group relative bg-white/5 backdrop-blur-xl p-6 md:p-10 rounded-3xl md:rounded-[4rem] border border-white/10 hover:border-secondary/20 hover:bg-white/10 transition-all duration-700 reveal delay-${(index + 1) * 100}`}>
                   <div class="absolute -top-12 -right-12 w-48 h-48 bg-secondary/5 rounded-full blur-[60px] group-hover:bg-secondary/15 transition-all"></div>
                   
                   <div class="relative overflow-hidden mb-10 rounded-2xl md:rounded-[3rem] aspect-video ring-1 ring-white/10 shadow-2xl group-hover:ring-secondary/30 transition-all">
                      <iframe 
                         width="100%" height="100%" 
                         src={`https://www.youtube.com/embed/${episode.id}`} 
                         class="absolute inset-0 grayscale group-hover:grayscale-0 transition-all duration-700 scale-105 group-hover:scale-100" 
                         allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                         allowfullscreen
                      ></iframe>
                   </div>

                   <div class="relative z-10">
                      <div class="flex items-center justify-between mb-6">
                         <span class="text-secondary font-black text-[10px] uppercase tracking-widest">{episode.category}</span>
                         <span class="text-slate-500 font-bold text-xs uppercase tracking-widest">{episode.date}</span>
                      </div>
                      <h4 class="text-3xl font-black text-white mb-6 tracking-tight group-hover:text-secondary transition-colors underline decoration-secondary/0 group-hover:decoration-secondary/30 underline-offset-8 duration-500">{episode.title}</h4>
                      <p class="text-slate-400 font-medium leading-relaxed mb-10 line-clamp-2 group-hover:line-clamp-none transition-all duration-500">{episode.desc}</p>
                   </div>
                </div>
             ))}
          </div>
       </div>
    </section>

    <!-- Call to Action Premium -->
    <section class="py-48 bg-white overflow-hidden relative">
       <!-- Sound bar decor -->
       <div class="absolute bottom-0 left-0 right-0 h-2 bg-slate-100">
          <div class="h-full bg-secondary w-1/3 animate-[slide_10s_linear_infinite]"></div>
       </div>

       <div class="container mx-auto px-6 text-center reveal">
          <div class="w-24 h-24 bg-slate-900 rounded-[2.5rem] flex items-center justify-center text-secondary mx-auto mb-12 shadow-2xl shadow-secondary/10 group animate-bounce">
             <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
          </div>
          <h2 class="text-6xl font-black text-slate-900 mb-8 tracking-tightest leading-tight">¿Tienes una <span class="text-secondary">propuesta</span>?</h2>
          <p class="text-slate-500 max-w-2xl mx-auto mb-14 text-xl font-medium leading-relaxed">Colabora con nosotros y lleva el conocimiento técnico a todo el territorio nacional.</p>
          <Button variant="primary" size="lg" href="https://api.whatsapp.com/send?phone=573042247552">Contactar Producción</Button>
       </div>
    </section>
  </main>

  <style>
     @keyframes soundWave {
        from { transform: scaleY(0.5); }
        to { transform: scaleY(1); }
     }
     @keyframes slide {
        from { transform: translateX(-100%); }
        to { transform: translateX(300%); }
     }
  </style>
</Layout>
