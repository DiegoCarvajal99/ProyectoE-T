---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

// Episodios ordenados según requerimiento oficial (del 1 al 5)
const allEpisodes = [
  { 
    id: '5M33hoZ1JujF1TIWQUYJTx', 
    title: '1. Mujeres y Desarrollo', 
    category: 'Institucional',
    date: '01 Jun 2021',
    description: 'Introducción oficial al programa y su propósito de visibilizar el liderazgo femenino en la ciencia y el territorio.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`
  },
  { 
    id: '5RKxgQRTgpaJdrBJEP5NpV', 
    title: '2. Mujer y Ciencia', 
    category: 'Investigación',
    date: '01 Jun 2021',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2v4"/><path d="m21.8 17.6-6.5-11.4c-.4-.7-.9-1.2-1.6-1.2H10.3c-.7 0-1.2.5-1.6 1.2L2.2 17.6c-.4.7-.4 1.5 0 2.2.4.7 1.1 1.2 1.9 1.2h15.8c.8 0 1.5-.5 1.9-1.2.4-.7.4-1.5 0-2.2z"/><path d="M10 10h4"/></svg>`
  },
  { 
    id: '5OiCqZD0y1gIlgqczMtU1f', 
    title: '3. Cultura y Sostenibilidad desde la Antropología', 
    category: 'Antropología',
    date: '22 Jun 2021',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`
  },
  { 
    id: '0mfspEjbaHxQPUAXGbJZyv', 
    title: '4. Una visión desde la ingeniería', 
    category: 'Ingeniería',
    date: '20 Jul 2021',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
  },
  { 
    id: '0W80yGiN49506fuUfInRE7', 
    title: '5. Barreras para Mujeres STEM', 
    category: 'Ciencia y Género',
    date: '10 Ago 2021',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Z"/><path d="m19 15.5-1.4-1.4"/><path d="M15.5 19l-1.4-1.4"/><path d="M19 8.5l-1.4 1.4"/><path d="M15.5 5l-1.4 1.4"/><path d="m8.5 19 1.4-1.4"/><path d="M5 15.5l1.4-1.4"/><path d="M8.5 5l1.4 1.4"/><path d="M5 8.5l1.4 1.4"/></svg>`
  }
];

const featuredEpisode = allEpisodes[0];
const archiveEpisodes = allEpisodes.slice(1);
---

<Layout title="Mujeres y Desarrollo | Podcast ETF">
  <main class="bg-white">
    <!-- Hero Section con Glassmorphism -->
    <section class="relative min-h-screen flex items-center bg-slate-950 overflow-hidden pt-20">
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" 
          alt="Women in Science" 
          class="w-full h-full object-cover opacity-20 grayscale"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-indigo-950/40 to-slate-950"></div>
      </div>

      <!-- Animated Glows -->
      <div class="absolute top-1/4 -left-20 w-96 h-96 bg-indigo-500/20 rounded-full blur-[120px] animate-pulse"></div>
      <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-primary/20 rounded-full blur-[100px] animate-pulse delay-700"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
          <div class="reveal">
            <div class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 px-5 py-2 rounded-full mb-10">
               <span class="w-2 h-2 bg-indigo-400 rounded-full animate-ping"></span>
               <span class="text-indigo-200 text-xs font-black uppercase tracking-[0.2em]">Podcast Original ETF</span>
            </div>
            <h1 class="text-6xl md:text-8xl font-black text-white mb-8 tracking-tightest leading-[0.9]">
              Mujeres y <br/> <span class="text-gradient">Desarrollo</span>
            </h1>
            <p class="text-xl text-slate-400 font-medium leading-relaxed max-w-xl mb-12">
              Voces femeninas liderando la transformación territorial a través de la ciencia y la tecnología.
            </p>
            <div class="flex flex-wrap gap-6">
               <Button variant="primary" size="lg" href="#episodios">Explorar Episodios</Button>
               <a href="https://open.spotify.com/show/7kxZCnwOXGkDjEg0STuRXv" target="_blank" class="flex items-center gap-3 text-white font-bold hover:text-indigo-400 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[#1DB954]"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm5.503 17.296c-.217.356-.678.47-1.034.252-2.867-1.751-6.475-2.147-10.725-1.176-.407.093-.814-.158-.908-.564-.093-.406.158-.813.564-.907 4.646-1.063 8.625-.615 11.85 1.353.356.218.47.679.253 1.042zm1.47-3.256c-.274.444-.852.585-1.296.311-3.28-2.015-8.28-2.597-12.16-1.417-.5.152-1.025-.133-1.177-.633-.151-.5.132-1.025.632-1.177 4.414-1.34 9.93-.685 13.693 1.623.444.274.585.852.31 1.294zm.126-3.383c-3.935-2.338-10.435-2.553-14.215-1.405-.603.184-1.248-.162-1.43-.765-.183-.604.162-1.248.765-1.43 4.346-1.32 11.517-1.066 16.035 1.614.542.322.72 1.02.398 1.562-.322.541-1.02.72-1.553.424z"/></svg>
                  Seguir en Spotify
               </a>
            </div>
          </div>

          <div class="relative reveal delay-300">
             <div class="absolute -inset-10 bg-indigo-500/20 blur-[60px] rounded-full"></div>
             <!-- Featured Card -->
             <div class="relative bg-white/10 backdrop-blur-2xl border border-white/20 p-6 md:p-10 rounded-3xl md:rounded-[3.5rem] shadow-2xl">
                <div class="flex items-center gap-4 mb-8">
                   <div class="w-12 h-12 rounded-2xl bg-indigo-500/30 flex items-center justify-center text-indigo-300" set:html={featuredEpisode.icon} />
                   <div>
                      <p class="text-indigo-400 text-[10px] font-black uppercase tracking-widest">{featuredEpisode.category}</p>
                      <p class="text-white font-bold">{featuredEpisode.date}</p>
                   </div>
                </div>
                <h3 class="text-3xl font-black text-white mb-6 tracking-tight leading-tight">{featuredEpisode.title}</h3>
                <p class="text-slate-400 mb-10 leading-relaxed font-medium">{featuredEpisode.description}</p>
                <div class="rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10">
                   <iframe 
                      style="border-radius:0px" 
                      src={`https://open.spotify.com/embed/episode/${featuredEpisode.id}?utm_source=generator&theme=0`} 
                      width="100%" 
                      height="152" 
                      frameBorder="0" 
                      allowfullscreen="" 
                      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                      loading="lazy"
                   ></iframe>
                </div>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Archive Section con Glass Cards -->
    <section id="episodios" class="py-40 bg-slate-50 relative overflow-hidden">
      <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-24 reveal">
           <SectionHeader 
             tag="Ciclo de Emisiones"
             title="Archivo del Podcast"
             subtitle="Explora los episodios en el orden oficial de la serie."
             centered={false}
           />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10">
          {allEpisodes.map((episode, index) => (
            <div class={`group relative bg-white/60 backdrop-blur-xl p-5 md:p-10 rounded-3xl md:rounded-[4rem] border border-white shadow-xl shadow-indigo-100/30 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 reveal delay-${(index + 1) * 100}`}>
               <!-- Topic Label -->
               <div class="absolute -top-4 -right-4 px-6 py-2 bg-indigo-600 rounded-full shadow-xl shadow-indigo-200 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                  <span class="text-white text-[10px] font-black uppercase tracking-widest">{episode.category}</span>
               </div>

               <div class="flex items-center gap-6 mb-10">
                  <div class="w-16 h-16 rounded-[2rem] bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-500 shadow-inner" set:html={episode.icon} />
                  <div>
                    <span class="text-indigo-400 font-black text-[9px] uppercase tracking-widest mb-1 block">{episode.date}</span>
                    <h4 class="text-slate-900 font-bold text-2xl tracking-tighter leading-none group-hover:text-indigo-600 transition-colors">{episode.title}</h4>
                  </div>
               </div>
               
               <div class="rounded-2xl md:rounded-[2.5rem] overflow-hidden bg-slate-900 shadow-2xl ring-[4px] md:ring-8 ring-white/50 group-hover:ring-indigo-100 transition-all duration-500 min-h-[152px]">
                  <iframe 
                    style="border-radius:0px" 
                    src={`https://open.spotify.com/embed/episode/${episode.id}?utm_source=generator&theme=0`} 
                    width="100%" 
                    height="152" 
                    frameBorder="0" 
                    allowfullscreen="" 
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                    loading="lazy"
                  ></iframe>
               </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Support Section Premium -->
    <section class="py-48 bg-white relative overflow-hidden">
      <!-- Decoración de fondo -->
      <div class="absolute top-0 right-0 w-1/2 h-full bg-indigo-50/30 skew-x-12 translate-x-1/2"></div>
      
      <div class="container mx-auto px-6 relative z-10">
         <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-20">
            <div class="md:w-1/2 reveal">
               <h2 class="text-6xl font-black text-slate-900 mb-8 tracking-tightest leading-tight">¿Tienes una <span class="text-indigo-600">historia</span> que contar?</h2>
               <p class="text-xl text-slate-500 mb-12 font-medium leading-relaxed">Buscamos científicas, ingenieras y lideresas comunitarias para nuestro próximo ciclo de emisiones.</p>
               <Button variant="primary" size="lg" href="https://api.whatsapp.com/send?phone=573042247552&text=Hola,%20quisiera%20participar%20en%20el%20podcast%20Mujeres%20y%20Desarrollo">
                  Quiero ser invitada
               </Button>
            </div>
            <div class="md:w-1/2 reveal delay-400">
               <div class="relative">
                  <div class="absolute -inset-4 bg-indigo-200 blur-2xl rounded-full opacity-30 animate-pulse"></div>
                  <img 
                    src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                    alt="Women collaborating" 
                    class="relative rounded-[5rem] shadow-2xl border-8 border-white"
                  />
               </div>
            </div>
         </div>
      </div>
    </section>
  </main>
</Layout>
