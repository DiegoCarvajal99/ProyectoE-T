<script>
  const toggleBtn = document.querySelector('#toggle-team');
  const extendedTeamContainer = document.querySelector('#extended-team-container');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = extendedTeamContainer?.style.gridTemplateRows === '1fr';
    
    if (isExpanded) {
      extendedTeamContainer.style.gridTemplateRows = '0fr';
      extendedTeamContainer.style.opacity = '0';
      toggleBtn.textContent = 'Ver todo el equipo';
    } else {
      extendedTeamContainer.style.gridTemplateRows = '1fr';
      extendedTeamContainer.style.opacity = '1';
      toggleBtn.textContent = 'Mostrar menos';
    }
  });
</script>

