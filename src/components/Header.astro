---
import Button from './Button.astro';

const navItems = [
  { name: 'Inicio', href: '#inicio' },
  { name: 'Nosotros', href: '#mision' },
  { name: 'Academia', href: '#academia' },
  { name: 'Publicaciones', href: '#revistas' },
  { name: 'Investigación', href: '#idi' },
  { name: 'Proyectos', href: '#proyectos' },
  { name: 'Podcast', href: '#podcast' },
  { name: 'Equipo', href: '#equipo' },
  { name: 'Contacto', href: '#contacto' },
];

const icons = {
  menu: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`,
  close: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>`
};
---

<header class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300">
  <div id="desktop-header" class="w-full px-6 lg:px-12 h-20 flex items-center justify-between bg-white/80 backdrop-blur-xl border-b border-slate-100 shadow-sm transition-all duration-300">
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-secondary rounded-xl flex items-center justify-center text-white font-bold shadow-lg ring-4 ring-secondary/5 group-hover:rotate-6 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 5.9a7 7 0 1 1-9 12.1z"/><path d="M11 20v-3a2 2 0 0 1 4 0v3"/></svg>
      </div>
      <div class="flex flex-col">
        <span class="text-slate-900 font-display font-black text-sm leading-none tracking-tight">ETF FOUNDATION</span>
        <span class="text-primary font-display text-[9px] font-bold tracking-[0.2em] uppercase">REGENERATION</span>
      </div>
    </a>

    <!-- Desktop Nav: Back to TEXT labels -->
    <nav class="hidden lg:flex items-center gap-8">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-slate-500 hover:text-primary font-bold transition-all duration-200 text-[10px] uppercase tracking-[0.2em] relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-primary hover:after:w-full after:transition-all"
        >
          {item.name}
        </a>
      ))}
      <Button variant="primary" size="sm" href="#donar" class="ml-4 rounded-xl px-6">Donar</Button>
    </nav>

    <!-- Mobile Menu Button (Hamburger) -->
    <button id="menu-toggle" class="lg:hidden p-3 text-slate-800 hover:bg-slate-50 rounded-xl transition-colors relative z-[110]" aria-label="Menu">
      <div id="hamburger-icon" class="transition-transform duration-300">
         <Fragment set:html={icons.menu} />
      </div>
    </button>
  </div>

  <!-- Mobile Drawer: Slide from LEFT -->
  <div id="mobile-overlay" class="fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-[105] hidden opacity-0 transition-opacity duration-500"></div>
  
  <div id="mobile-menu" class="fixed top-0 left-0 bottom-0 w-[80%] max-w-[320px] bg-white z-[110] -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex flex-col p-8 shadow-2xl">
    <div class="flex items-center justify-between mb-12">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-secondary rounded-lg flex items-center justify-center text-white">
           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 5.9a7 7 0 1 1-9 12.1z"/></svg>
        </div>
        <span class="text-slate-900 font-display font-black text-xs tracking-tight">ETF MENU</span>
      </div>
      <button id="menu-close" class="p-2 text-slate-400 hover:text-slate-900 transition-colors">
         <Fragment set:html={icons.close} />
      </button>
    </div>

    <nav class="flex flex-col gap-6">
      {navItems.map((item, index) => (
        <a 
          href={item.href} 
          class="mobile-link text-lg font-black text-slate-400 hover:text-primary transition-all tracking-tight translate-x-[-20px] opacity-0"
          style={`transition-delay: ${index * 50}ms`}
        >
          {item.name}
        </a>
      ))}
    </nav>
    
    <div class="mt-auto pt-8 border-t border-slate-100 flex flex-col gap-4">
       <Button variant="primary" size="lg" href="#donar" class="w-full">Donar Ahora</Button>
       <p class="text-[9px] font-black uppercase tracking-[0.4em] text-slate-300 text-center">Environment & Tech</p>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector('#menu-toggle');
  const closeBtn = document.querySelector('#menu-close');
  const overlay = document.querySelector('#mobile-overlay');
  const mobileMenu = document.querySelector('#mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const headerContainer = document.querySelector('#desktop-header');

  function openMenu() {
    overlay?.classList.remove('hidden');
    setTimeout(() => {
      overlay?.classList.add('opacity-100');
      mobileMenu?.classList.remove('-translate-x-full');
    }, 10);
    
    document.body.style.overflow = 'hidden';
    
    mobileLinks.forEach(link => {
       link?.classList.remove('translate-x-[-20px]', 'opacity-0');
       link?.classList.add('translate-x-0', 'opacity-100');
    });
  }

  function closeMenu() {
    overlay?.classList.remove('opacity-100');
    mobileMenu?.classList.add('-translate-x-full');
    
    mobileLinks.forEach(link => {
       link?.classList.add('translate-x-[-20px]', 'opacity-0');
       link?.classList.remove('translate-x-0', 'opacity-100');
    });

    setTimeout(() => {
      overlay?.classList.add('hidden');
    }, 500);
    
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Scroll visibility logic
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      headerContainer?.classList.remove('bg-white/80');
      headerContainer?.classList.add('bg-white/95', 'shadow-lg', 'border-b-secondary/5');
    } else {
      headerContainer?.classList.add('bg-white/80');
      headerContainer?.classList.remove('bg-white/95', 'shadow-lg', 'border-b-secondary/5');
    }
  });
</script>
