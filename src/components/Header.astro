---
import Button from './Button.astro';

const isHome = Astro.url.pathname === '/';

const transformHref = (href: string) => {
  if (href.startsWith('#') && !isHome) {
    return `/${href}`;
  }
  return href;
};

const navItems = [
  { name: 'Inicio', href: transformHref('#inicio') },
  { name: 'Nosotros', href: transformHref('#mision') },
  { name: 'Academia', href: transformHref('#academia') },
  { 
    name: 'I+D+i', 
    href: transformHref('#idi'),
    submenu: [
      { name: 'Centro de Investigación', href: '/idi/centro' },
      { 
        name: 'Grupos de Investigación', 
        href: transformHref('#idi-grupos'),
        items: [
          { name: 'Ambiente y Tecnología', href: '/idi/ambiente' },
          { name: 'Dimmano', href: '/idi/dimmano' },
          { name: 'Sostenibilidad y Competitividad', href: '/idi/sostenibilidad' }
        ]
      },
      { name: 'Proyectos e Innovación', href: transformHref('#idi-proyectos') },
      { name: 'Publicaciones', href: transformHref('#revistas') }
    ]
  },
  { name: 'Equipo', href: transformHref('#equipo') },
  { name: 'Podcast', href: transformHref('#podcast') },
  { name: 'Contacto', href: transformHref('#contacto') },
];

const icons = {
  menu: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`,
  close: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>`
};
---

<header class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300">
  <div id="desktop-header" class="w-full px-6 lg:px-12 py-2 flex items-center justify-between bg-white/80 backdrop-blur-xl border-b border-slate-100 shadow-sm transition-all duration-300">
    <!-- Logo -->
    <a href={transformHref('#inicio')} class="flex items-center group py-2 relative">
      <img src="https://res.cloudinary.com/dpcm4gpua/image/upload/v1775604597/5dc76a18-350c-4d1e-ad22-9fd0f151925b.png" alt="ETF Logo" class="h-10 lg:h-12 w-auto object-contain drop-shadow-sm group-hover:drop-shadow-md transition-all duration-500 group-hover:-translate-y-0.5" />
    </a>

    <!-- Desktop Nav: Back to TEXT labels with DROPDOWNS -->
    <nav class="hidden lg:flex items-center gap-8">
      {navItems.map(item => (
        <div class="relative group h-full flex items-center">
          <a 
            href={item.href} 
            class="text-slate-500 hover:text-primary font-bold transition-all duration-200 text-[10px] uppercase tracking-[0.2em] relative py-8 after:content-[''] after:absolute after:bottom-5 after:left-0 after:w-0 after:h-0.5 after:bg-primary hover:after:w-full after:transition-all flex items-center gap-1"
          >
            {item.name}
            {item.submenu && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-180 transition-transform"><path d="m6 9 6 6 6-6"/></svg>}
          </a>

          {item.submenu && (
            <div class="absolute top-[80px] left-0 w-64 bg-white/95 backdrop-blur-xl border border-slate-100 shadow-2xl rounded-2xl p-4 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 z-[120]">
              <div class="space-y-4">
                {item.submenu.map(sub => (
                  <div class="relative group/sub">
                    <a 
                      href={sub.href} 
                      class="block text-slate-800 hover:text-primary font-black text-[10px] uppercase tracking-widest transition-colors py-2 flex items-center justify-between"
                    >
                      {sub.name}
                      {sub.items && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>}
                    </a>
                    
                    {sub.items && (
                      <div class="absolute top-0 left-full ml-4 w-56 bg-white border border-slate-100 shadow-xl rounded-xl p-3 opacity-0 invisible translate-x-2 group-hover/sub:opacity-100 group-hover/sub:visible group-hover/sub:translate-x-0 transition-all">
                        {sub.items.map(nested => (
                          <a 
                            href={nested.href} 
                            class="block text-slate-500 hover:text-primary font-bold text-[9px] uppercase tracking-widest py-2 px-2 hover:bg-slate-50 rounded-lg transition-all"
                          >
                            {nested.name}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}

      <!-- Lang Switcher Desktop -->
      <div class="relative group h-full flex items-center ml-2 border-l border-slate-100 pl-4">
        <button aria-label="Cambiar Idioma" class="flex items-center gap-1.5 text-slate-500 hover:text-primary transition-colors text-[10px] font-bold uppercase tracking-widest relative py-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          <span class="active-lang-text">ES</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-180 transition-transform"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-[70px] right-0 w-32 bg-white/95 backdrop-blur-xl border border-slate-100 shadow-2xl rounded-2xl p-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 z-[120]">
          <div class="flex flex-col gap-1">
            <button onclick="changeGTranslate('es')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇪🇸</span> Español</button>
            <button onclick="changeGTranslate('en')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇺🇸</span> English</button>
            <button onclick="changeGTranslate('it')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇮🇹</span> Italiano</button>
          </div>
        </div>
      </div>

      <Button variant="primary" size="sm" href="#donar" class="ml-4 rounded-xl px-6">Donar</Button>
    </nav>

    <!-- Mobile Actions (Lang + Hamburger) -->
    <div class="flex items-center gap-1 lg:hidden">
      <!-- Lang Switcher Mobile Dropdown -->
      <div class="relative flex items-center z-[220]">
        <button id="mobile-lang-toggle" onclick="toggleMobileLang(event)" aria-label="Cambiar Idioma" class="flex items-center gap-1 text-slate-500 transition-colors text-[10px] font-bold uppercase tracking-widest p-2 rounded-xl bg-slate-50/50 hover:bg-slate-100">
          <span class="active-lang-text">ES</span>
          <svg id="mobile-lang-arrow" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="mobile-lang-dropdown" class="absolute top-[40px] right-0 w-32 bg-white/95 backdrop-blur-xl border border-slate-100 shadow-2xl rounded-2xl p-2 transition-all duration-300 opacity-0 invisible translate-y-2">
          <div class="flex flex-col gap-1">
            <button onclick="changeGTranslate('es')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇪🇸</span> Español</button>
            <button onclick="changeGTranslate('en')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇺🇸</span> English</button>
            <button onclick="changeGTranslate('it')" class="text-left px-3 py-2 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center gap-2"><span class="text-base">🇮🇹</span> Italiano</button>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <button id="menu-toggle" class="p-2 text-slate-800 hover:bg-slate-50 rounded-xl relative z-[220]" aria-label="Menu">
        <div id="hamburger-icon">
           <Fragment set:html={icons.menu} />
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer: Slide from LEFT -->
  <div id="mobile-overlay" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-[200] hidden opacity-0 transition-opacity duration-500"></div>
  
  <div id="mobile-menu" class="fixed top-0 left-0 bottom-0 w-[85%] max-w-[340px] bg-white z-[210] -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex flex-col p-8 shadow-2xl">
    <div class="flex items-center justify-between mb-12">
      <div class="flex items-center gap-2">
        <img src="https://res.cloudinary.com/dpcm4gpua/image/upload/v1775604597/5dc76a18-350c-4d1e-ad22-9fd0f151925b.png" alt="ETF Logo" class="h-8 w-auto object-contain drop-shadow-sm" />
      </div>
      <button id="menu-close" class="p-2 text-slate-400 hover:text-slate-900 transition-colors">
         <Fragment set:html={icons.close} />
      </button>
    </div>

    <nav class="flex flex-col gap-4 overflow-y-auto max-h-[60vh] pr-2 custom-scroll">
      {navItems.map((item, index) => (
        <div class="mobile-nav-item">
          <div class="flex items-center justify-between">
            <a 
              href={item.href} 
              class="mobile-link text-lg font-black text-slate-400 hover:text-primary transition-all tracking-tight translate-x-[-20px] opacity-0"
              style={`transition-delay: ${index * 50}ms`}
            >
              {item.name}
            </a>
            {item.submenu && (
              <button class="mobile-submenu-toggle p-2 text-slate-300" aria-label="Expand submenu">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            )}
          </div>
          
          {item.submenu && (
            <div class="mobile-submenu hidden flex flex-col gap-3 pl-4 mt-3 border-l-2 border-slate-50">
              {item.submenu.map(sub => (
                <div>
                  <a 
                    href={sub.href} 
                    class="text-sm font-bold text-slate-500 hover:text-primary"
                  >
                    {sub.name}
                  </a>
                  {sub.items && (
                    <div class="flex flex-col gap-2 pl-4 mt-2">
                      {sub.items.map(nested => (
                        <a 
                          href={nested.href} 
                          class="text-xs font-medium text-slate-400 hover:text-secondary"
                        >
                          • {nested.name}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    
    <div class="mt-auto pt-8 border-t border-slate-100 flex flex-col gap-4">
       <Button variant="primary" size="lg" href="#donar" class="w-full">Donar Ahora</Button>
       <p class="text-[9px] font-black uppercase tracking-[0.4em] text-slate-300 text-center">Environment & Tech</p>
    </div>
  </div>
</header>

<script>
  /**
   * Encapsula la lógica del header para que sea compatible con Astro View Transitions.
   * Se ejecuta en cada 'astro:page-load' para asegurar que los elementos del nuevo DOM
   * tengan sus eventos vinculados correctamente.
   */
  function initHeader() {
    const toggleBtn = document.querySelector('#menu-toggle');
    const closeBtn = document.querySelector('#menu-close');
    const overlay = document.querySelector('#mobile-overlay');
    const mobileMenu = document.querySelector('#mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const headerContainer = document.querySelector('#desktop-header');

    if (!toggleBtn || !mobileMenu || !overlay) return;

    // Estado interno para prevenir ejecuciones duplicadas si el evento se dispara varias veces
    let isTransitioning = false;

    function openMenu() {
      if (isTransitioning) return;
      isTransitioning = true;

      overlay?.classList.remove('hidden');
      // Forzar un frame para que la transición de opacidad funcione
      requestAnimationFrame(() => {
        overlay?.classList.add('opacity-100');
        overlay?.classList.remove('pointer-events-none');
        mobileMenu?.classList.remove('-translate-x-full');
      });
      
      document.body.style.overflow = 'hidden';
      
      mobileLinks.forEach(link => {
         link?.classList.remove('translate-x-[-20px]', 'opacity-0');
         link?.classList.add('translate-x-0', 'opacity-100');
      });

      setTimeout(() => { isTransitioning = false; }, 500);
    }

    function closeMenu() {
      if (isTransitioning) return;
      isTransitioning = true;

      overlay?.classList.remove('opacity-100');
      overlay?.classList.add('pointer-events-none');
      mobileMenu?.classList.add('-translate-x-full');
      
      mobileLinks.forEach(link => {
         link?.classList.add('translate-x-[-20px]', 'opacity-0');
         link?.classList.remove('translate-x-0', 'opacity-100');
      });

      setTimeout(() => {
        overlay?.classList.add('hidden');
        isTransitioning = false;
      }, 500);
      
      document.body.style.overflow = '';
    }

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isCurrentlyOpen = !mobileMenu?.classList.contains('-translate-x-full');
        if (isCurrentlyOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Mobile Submenu Toggles
    const subMenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    subMenuToggles.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const parent = btn.closest('.mobile-nav-item');
        const subMenu = parent?.querySelector('.mobile-submenu');
        const arrow = btn.querySelector('svg');
        
        subMenu?.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
      });
    });

    // Scroll visibility logic
    const handleScroll = () => {
      if (window.scrollY > 50) {
        headerContainer?.classList.remove('bg-white/80');
        headerContainer?.classList.add('bg-white/95', 'shadow-lg', 'border-b-secondary/5');
      } else {
        headerContainer?.classList.add('bg-white/80');
        headerContainer?.classList.remove('bg-white/95', 'shadow-lg', 'border-b-secondary/5');
      }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();
  }

  // En Astro con View Transitions, 'astro:page-load' se dispara en carga inicial y cada navegación.
  document.addEventListener('astro:page-load', initHeader);
  if (!document.querySelector('#desktop-header')?.hasAttribute('data-initialized')) {
    initHeader();
    document.querySelector('#desktop-header')?.setAttribute('data-initialized', 'true');
  }

  // Lógica de GTranslate Segura
  window.changeGTranslate = function(lang) {
      if (lang === 'es') {
          document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
          document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; domain=${window.location.hostname}; path=/;`;
      } else {
          document.cookie = `googtrans=/es/${lang}; path=/;`;
      }
      window.location.reload();
  };

  function updateActiveLanguageUI() {
      const match = document.cookie.match(/googtrans=\/es\/([a-z]{2})/);
      const activeLang = match ? match[1].toUpperCase() : 'ES';
      
      // Actualizar texto desktop y móvil
      document.querySelectorAll('.active-lang-text').forEach(el => el.innerText = activeLang);
  }

  document.addEventListener('DOMContentLoaded', updateActiveLanguageUI);
  document.addEventListener('astro:page-load', updateActiveLanguageUI);

  // Global Mobile Lang Dropdown Logic (Seguro contra re-renders de Astro)
  window.toggleMobileLang = function(e) {
      if (e) e.stopPropagation();
      const dropdown = document.querySelector('#mobile-lang-dropdown');
      const arrow = document.querySelector('#mobile-lang-arrow');
      if (!dropdown) return;

      const isOpen = !dropdown.classList.contains('invisible');
      if (isOpen) {
          dropdown.classList.replace('opacity-100', 'opacity-0');
          dropdown.classList.replace('visible', 'invisible');
          dropdown.classList.replace('translate-y-0', 'translate-y-2');
          arrow?.classList.remove('rotate-180');
      } else {
          dropdown.classList.replace('opacity-0', 'opacity-100');
          dropdown.classList.replace('invisible', 'visible');
          dropdown.classList.replace('translate-y-2', 'translate-y-0');
          arrow?.classList.add('rotate-180');
      }
  };

  // Cierre global al clicar fuera
  document.addEventListener('click', (e) => {
      const dropdown = document.querySelector('#mobile-lang-dropdown');
      const toggle = document.querySelector('#mobile-lang-toggle');
      const arrow = document.querySelector('#mobile-lang-arrow');
      
      if (dropdown && toggle && !dropdown.contains(e.target) && !toggle.contains(e.target)) {
          dropdown.classList.replace('opacity-100', 'opacity-0');
          dropdown.classList.replace('visible', 'invisible');
          dropdown.classList.replace('translate-y-0', 'translate-y-2');
          arrow?.classList.remove('rotate-180');
      }
  });
</script>

<style>
  .custom-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scroll::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 10px;
  }
</style>
