---
const footerLinks = {
  about: [
    { name: 'Nuestra Misión', href: '#mision' },
    { name: 'El Equipo', href: '#equipo' },
    { name: 'Impacto Ambiental', href: '#impacto' },
  ],
  resources: [
    { name: 'Publicaciones', href: '/publicaciones' },
    { name: 'Revista E&T', href: '/revista' },
    { name: 'Podcast', href: '/podcast' },
  ],
  social: [
    { name: 'Instagram', icon: 'instagram', href: 'https://instagram.com/environmentytec' },
    { name: 'Facebook', icon: 'facebook', href: '#' },
    { name: 'LinkedIn', icon: 'linkedin', href: '#' },
    { name: 'Twitter', icon: 'twitter', href: '#' },
  ]
};
---

<footer class="bg-slate-900 border-t border-slate-800 pt-24 pb-12 px-6 overflow-hidden">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 mb-20 relative">
      <!-- Decorative Element -->
      <div class="absolute -top-12 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="md:col-span-5 pr-8">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center text-white shadow-xl shadow-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 5.9a7 7 0 1 1-9 12.1z"/><path d="M11 20v-3a2 2 0 0 1 4 0v3"/></svg>
          </div>
          <span class="text-white font-display font-black text-xl tracking-tight">ETF Foundation</span>
        </div>
        <p class="text-slate-400 text-base leading-relaxed max-w-sm mb-10 font-medium">
          Impulsando la convergencia entre la tecnología de vanguardia y la conservación ambiental para un futuro regenerativo.
        </p>
        <div class="flex gap-4">
          {footerLinks.social.map(item => (
            <a href={item.href} class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white hover:border-primary transition-all duration-300">
              <span class="sr-only">{item.name}</span>
              <div class="w-1.5 h-1.5 rounded-full bg-current"></div>
            </a>
          ))}
        </div>
      </div>
      
      <div class="md:col-span-2">
        <h4 class="text-white font-display font-black uppercase tracking-widest text-xs mb-8">Explora</h4>
        <ul class="space-y-4">
          {footerLinks.about.map(link => (
            <li><a href={link.href} class="text-slate-400 hover:text-primary transition-colors text-sm font-bold tracking-tight">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-white font-display font-black uppercase tracking-widest text-xs mb-8">Recursos</h4>
        <ul class="space-y-4">
          {footerLinks.resources.map(link => (
            <li><a href={link.href} class="text-slate-400 hover:text-primary transition-colors text-sm font-bold tracking-tight">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h4 class="text-white font-display font-black uppercase tracking-widest text-xs mb-8">Ubicación</h4>
        <p class="text-slate-400 text-sm font-bold leading-loose mb-2">
          Cereté, Córdoba, Colombia<br/>
          Barrio Las Américas. Cra 8, Calle 23.
        </p>
        <div class="mt-6 pt-6 border-t border-slate-800">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-1 font-black">Contacto Directo</p>
          <p class="text-primary font-black tracking-tight underline decoration-primary/30 underline-offset-8">etf_@environmenttechnologyfoundation.org</p>
        </div>
      </div>
    </div>

    <!-- Legal and Bottom -->
    <div class="pt-8 border-t border-slate-800/50 flex flex-col md:flex-row items-center justify-between gap-6 text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em]">
      <p>&copy; {new Date().getFullYear()} ENVIRONMENT & TECHNOLOGY FOUNDATION - ECO-TECH REGENERATION</p>
      <div class="flex gap-8">
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <a href="#" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
