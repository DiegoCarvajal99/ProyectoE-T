---

<footer class="bg-slate-950 border-t border-white/5 pt-32 pb-16 px-6 overflow-hidden relative">
  <!-- Dynamic Glow Background -->
  <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] -z-10 pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-secondary/5 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 mb-24">
      
      <!-- Brand Identity -->
      <div class="md:col-span-4 lg:col-span-5">
        <div class="flex items-center mb-10 group relative w-max">
          <!-- Ambient Glow for Logo -->
          <div class="absolute inset-0 bg-white/10 blur-[2rem] rounded-full scale-150 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
          <img src="https://res.cloudinary.com/dpcm4gpua/image/upload/v1775604597/5dc76a18-350c-4d1e-ad22-9fd0f151925b.png" alt="ETF Logo" class="relative z-10 h-10 md:h-12 w-auto object-contain drop-shadow-2xl group-hover:-translate-y-1 group-hover:drop-shadow-[0_20px_40px_rgba(255,255,255,0.1)] transition-all duration-500" />
        </div>
        
        <p class="text-slate-400 text-lg leading-relaxed max-w-sm mb-12 font-medium">
          Dedicados a la investigación y desarrollo socioambiental mediante la tecnociencia aplicada.
        </p>

        <!-- Social Grids -->
        <div class="flex flex-wrap gap-4">
          {footerLinks.social.map(item => (
            <a 
              href={item.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-12 h-12 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center text-slate-400 hover:text-primary hover:border-primary hover:bg-primary/5 transition-all duration-300"
              title={item.name}
            >
              <span class="flex items-center justify-center" set:html={item.icon} />
            </a>
          ))}
        </div>
      </div>
      
      <!-- Links Columns -->
      <div class="md:col-span-2 lg:col-span-2">
        <h4 class="text-white font-black uppercase tracking-[0.2em] text-[10px] mb-10 pb-4 border-b border-white/5">Explora</h4>
        <ul class="space-y-6">
          {footerLinks.about.map(link => (
            <li><a href={link.href} class="text-slate-500 hover:text-white transition-colors text-sm font-bold tracking-tight block">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2 lg:col-span-2">
        <h4 class="text-white font-black uppercase tracking-[0.2em] text-[10px] mb-10 pb-4 border-b border-white/5">Recursos</h4>
        <ul class="space-y-6">
          {footerLinks.resources.map(link => (
            <li><a href={link.href} class="text-slate-500 hover:text-white transition-colors text-sm font-bold tracking-tight block">{link.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="md:col-span-4 lg:col-span-3">
        <h4 class="text-white font-black uppercase tracking-[0.2em] text-[10px] mb-10 pb-4 border-b border-white/5">Conecta</h4>
        <div class="space-y-8">
          <div>
             <p class="text-[9px] font-black uppercase tracking-[0.2em] text-primary mb-3">WhatsApp Oficial</p>
             <a href="https://api.whatsapp.com/send?phone=573042247552" target="_blank" class="text-white font-black text-lg hover:text-primary transition-colors tracking-tight block">
                (+57) 304 224 7552
             </a>
          </div>
          <div>
             <p class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-500 mb-3">Sede Central</p>
             <p class="text-slate-400 text-sm font-bold leading-relaxed mb-4">
                Cereté, Córdoba, Colombia<br/>
                Barrio Las Américas. Cra 8, Calle 23.
             </p>
          </div>
          <div class="pt-6 border-t border-white/5">
            <p class="text-[9px] font-black uppercase tracking-[0.2em] text-primary mb-3">Correo Electrónico</p>
            <p class="text-white text-sm font-black tracking-tight break-all">etf_@environmenttechnologyfoundation.org</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright & Legal -->
    <div class="pt-12 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-8">
      <p class="text-[10px] text-slate-600 font-bold uppercase tracking-[0.2em]">
        &copy; {new Date().getFullYear()} ETF FOUNDATION. TODOS LOS DERECHOS RESERVADOS.
      </p>
      <div class="flex gap-10">
        <a href="/privacidad" class="text-[10px] text-slate-600 hover:text-white font-bold uppercase tracking-[0.2em] transition-colors">Privacidad</a>
        <a href="/terminos" class="text-[10px] text-slate-600 hover:text-white font-bold uppercase tracking-[0.2em] transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    backdrop-filter: blur(20px);
  }
</style>
