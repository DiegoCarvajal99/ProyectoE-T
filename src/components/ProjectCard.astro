---
interface Props {
  title: string;
  subtitle: string;
  category: string;
  tag: string;
  image: string;
  class?: string;
  size?: 'normal' | 'large' | 'tall';
  id?: string;
}

const { title, subtitle, category, tag, image, class: className, size = 'normal', id = "00" } = Astro.props;

const sizeClasses = {
  normal: 'h-[420px]',
  large: 'h-[420px]',
  tall: 'h-[420px]',
};
---

<div class:list={[
  'group relative overflow-hidden rounded-[3rem] bg-slate-950 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] hover:shadow-[0_40px_70px_rgba(153,194,33,0.25)] border border-white/5 hover:border-primary/40',
  sizeClasses[size],
  className
]}>
  <!-- Background Image with Specific Zoom Control -->
  <div class="absolute inset-0 overflow-hidden">
    <img 
      src={image} 
      alt={title} 
      class="h-full w-full object-cover transition-transform duration-[2000ms] group-hover:scale-110 brightness-[0.7] grayscale-[0.2] group-hover:grayscale-0 group-hover:brightness-[0.9]"
    />
  </div>

  <!-- Strong Bottom-to-Top Gradient Overlay for Legibility -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent opacity-90 group-hover:opacity-80 transition-opacity"></div>
  
  <!-- Subtle Top-Left Glow based on category/tag -->
  <div class="absolute top-0 left-0 w-32 h-32 bg-secondary/20 blur-[80px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>

  <!-- Content Layer -->
  <div class="absolute inset-0 p-10 flex flex-col justify-between z-10">
    <!-- Top info Bar -->
    <div class="flex items-start justify-between translate-y-[-10px] group-hover:translate-y-0 transition-all duration-700">
       <div class="flex items-center gap-4">
          <!-- Tech Icon Slot (Passed via slot or SVG logic) -->
          <div class="w-12 h-12 rounded-2xl bg-white/5 backdrop-blur-3xl border border-white/10 flex items-center justify-center text-secondary shadow-2xl">
             <slot name="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
             </slot>
          </div>
          <div class="flex flex-col">
             <span class="text-secondary font-black text-[10px] uppercase tracking-[0.4em] drop-shadow-lg">
                {tag}
             </span>
             <span class="text-white/40 font-mono text-[9px] font-bold">
                DATA-SYNC: {id}-00X
             </span>
          </div>
       </div>
    </div>

    <!-- Main Content Area -->
    <div class="transform transition-all duration-700 group-hover:translate-y-[-5px]">
      <div class="max-w-[85%]">
         <h3 class="text-3xl md:text-4xl font-black text-white leading-none mb-3 tracking-tightest drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]">
           {title}
         </h3>
         <!-- New Subtitle Context -->
         <p class="text-[#CBD5E1] text-sm md:text-base font-medium leading-relaxed mb-8 opacity-90 group-hover:opacity-100 transition-opacity">
           {subtitle}
         </p>
      </div>
      
      <!-- New High-Visibility CTA Button -->
      <a 
        href="#" 
        class="inline-flex items-center justify-between bg-[#F1F5F9] px-8 py-4 rounded-2xl w-full sm:w-auto min-w-[200px] border-2 border-primary/20 shadow-2xl transition-all duration-500 hover:bg-white hover:border-primary hover:scale-105 active:scale-95 group/cta overflow-hidden relative"
      >
        <span class="text-[#334155] text-xs font-black uppercase tracking-[0.2em] relative z-10 transition-colors group-hover/cta:text-secondary">
          Ver Proyecto
        </span>
        <div class="relative z-10 transition-transform duration-500 group-hover/cta:translate-x-1 group-hover/cta:text-secondary">
           <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover/cta:text-secondary"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <!-- Button Ripple effect hover -->
        <div class="absolute inset-0 bg-primary/5 translate-y-full group-hover/cta:translate-y-0 transition-transform duration-500"></div>
      </a>
    </div>
  </div>
</div>

<style>
  /* Extra smoothness for the glass elements */
  .glass {
     background: rgba(255, 255, 255, 0.05);
     backdrop-filter: blur(10px);
     -webkit-backdrop-filter: blur(10px);
  }
</style>
