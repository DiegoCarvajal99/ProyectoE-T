---
interface Props {
  title: string;
  subtitle: string;
  tag: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, tag, centered = true, light = false } = Astro.props;
---

<div class:list={["mb-20", centered ? "text-center max-w-4xl mx-auto" : "max-w-2xl text-left"]}>
  <div class:list={["inline-flex items-center gap-2 px-4 py-1.5 rounded-full border text-[10px] font-black uppercase tracking-[0.3em] text-primary mb-8", centered ? "mx-auto" : "", light ? "bg-white/5 border-white/10" : "bg-slate-50 border-slate-100"]}>
    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
    {tag}
  </div>
  <h2 class:list={["text-5xl md:text-6xl font-black mb-8 tracking-tightest leading-[1.05]", light ? "text-white" : "text-slate-900"]}>
    {title}
  </h2>
  <p class:list={["text-lg font-medium leading-relaxed", light ? "text-slate-400" : "text-slate-500"]}>
    {subtitle}
  </p>
</div>
